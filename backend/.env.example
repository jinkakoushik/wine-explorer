# Server
NODE_ENV=development
PORT=5000

# Database — MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/wine-explorer

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# CORS — allowed frontend origin
CLIENT_URL=http://localhost:5173
